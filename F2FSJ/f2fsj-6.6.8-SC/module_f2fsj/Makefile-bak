obj-m += f2fsj.o

f2fsj-y		:= dir.o file.o inode.o namei.o hash.o super.o inline.o
f2fsj-y		+= checkpoint.o gc.o data.o node.o segment.o recovery.o
f2fsj-y		+= shrinker.o extent_cache.o sysfs.o


f2fsj-$(CONFIG_F2FS_STAT_FS) += debug.o
f2fsj-$(CONFIG_F2FS_FS_XATTR) += xattr.o
f2fsj-$(CONFIG_F2FS_FS_POSIX_ACL) += acl.o
f2fsj-$(CONFIG_FS_VERITY) += verity.o
f2fsj-$(CONFIG_F2FS_FS_COMPRESSION) += compress.o
f2fsj-$(CONFIG_F2FS_IOSTAT) += iostat.o


#f2fsj-m += debug.o
#f2fsj-m += xattr.o
#f2fsj-m += acl.o
#f2fsj-m += verity.o
#f2fsj-m += compress.o
#f2fsj-$(CONFIG_F2FS_IOSTAT) += iostat.o

#f2fsj-y += fs/open.o fs/namei.o calc/calclock.o
f2fsj-y += calc/calclock.o

KDIR := /lib/modules/$(shell uname -r)/build
PWD := $(shell pwd)

default:
	$(MAKE) -C $(KDIR) M=$(PWD) modules

clean:
	$(MAKE) -C $(KDIR) M=$(PWD) clean

